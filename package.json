{
  "$schema": "https://json.schemastore.org/package",
  "name": "henriksoderlund-website",
  "description": "Henrik Söderlund's personal website - Technology Leader & AI Innovator. Built with Astro 6, TypeScript, and deployed on Cloudflare Workers.",
  "version": "3.0.0",
  "cloudflare": {
    "label": "henriksoderlund-website",
    "products": [
      "Workers"
    ],
    "categories": [],
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ],
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/fc7b4b62-442b-4769-641b-ad4422d74300/public",
    "publish": true
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.6"
  },
  "devDependencies": {
    "@paper-design/shaders": "0.0.81",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "oxlint": "1.87.0",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  },
  "scripts": {
    "dev": "node scripts/build-depth-grain.mjs && astro dev",
    "build": "node scripts/build-depth-grain.mjs && astro check && astro build && node scripts/patch-wrangler.mjs && node scripts/strip-prerender-nonce.mjs && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check": "pnpm run build",
    "deploy": "node scripts/build-depth-grain.mjs && astro build && node scripts/patch-wrangler.mjs && node scripts/strip-prerender-nonce.mjs && node scripts/verify-build.mjs && wrangler deploy",
    "lint": "oxlint",
    "test:e2e": "pnpm run build && playwright test",
    "test:prod": "E2E_TARGET=production playwright test",
    "cf-typegen": "wrangler types --env-file .dev.vars.example"
  },
  "type": "module",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
