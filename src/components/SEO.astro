---
interface Props {
  title: string;
  description: string;
  ogType?: 'profile' | 'website';
  /** Overrides the computed robots directive. Pass 'noindex, follow' to keep a page out of the index. */
  robots?: string;
}

const { title, description, ogType = 'website', robots } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.henriksoderlund.com';
const ogImageURL = `${siteBase}/og_image.png`;

// Normalised path: no trailing slash, so '/' becomes ''.
const pagePath = Astro.url.pathname.replace(/\/+$/, '');

// Utility pages that must never enter the index. BaseLayout does not forward a
// `robots` prop, so the exclusion is resolved here rather than at the call site.
const NOINDEX_PATHS = new Set(['/404']);

const robotsContent =
  robots ??
  (NOINDEX_PATHS.has(pagePath)
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1');

// Every `*.md.ts` route under src/pages is a plain-text twin of an HTML page.
// Globbing them keeps the alternate links in step with the filesystem, so a page
// without a twin can never emit a dead link.
const MARKDOWN_ROUTES = new Set(
  Object.keys(import.meta.glob('/src/pages/**/*.md.ts')).map((file) =>
    file.replace('/src/pages', '').replace(/\.ts$/, '')
  )
);

const markdownCandidate = pagePath === '' ? '/index.html.md' : `${pagePath}.md`;
const markdownURL = MARKDOWN_ROUTES.has(markdownCandidate)
  ? new URL(markdownCandidate, Astro.site).href
  : null;
---

<!-- Canonical -->
<link rel="canonical" href={canonicalURL.href} />

<!-- Indexing -->
<meta name="robots" content={robotsContent} />

<!-- Plain-text twin of this page, for agents and answer engines -->
{markdownURL && (
  <link rel="alternate" type="text/markdown" href={markdownURL} title="Markdown version" />
)}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:alt" content="Professional headshot of Henrik Soderlund on a dark background with name and title text" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Henrik Söderlund" />
<meta property="og:locale" content="en_AU" />

{ogType === 'profile' && (
  <>
    <meta property="profile:first_name" content="Henrik" />
    <meta property="profile:last_name" content="Söderlund" />
    <meta property="profile:username" content="henkisdabro" />
  </>
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@henkisdabro" />
<meta name="twitter:creator" content="@henkisdabro" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content="Professional headshot of Henrik Soderlund on a dark background with name and title text" />

<!-- SEO Verification -->
<meta name="google-site-verification" content="TVUdAh0RA_yjsXKKjybCDe7JsKnXBhYFbcRPoJy03rc" />
<meta name="ahrefs-site-verification" content="bc08e3a49be838e1d8cfa2eabc5bf8e7d833c572e09db62742db9ed9917d6ada" />
