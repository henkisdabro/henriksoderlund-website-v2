---
import { markdownTwinUrl, pageUrl, SITE_ORIGIN } from '../utils/pageUrl';

interface Props {
  title: string;
  description: string;
  ogType?: 'profile' | 'website';
  /** Overrides the default robots directive. Pass 'noindex, follow' to keep a page out of the index. */
  robots?: string;
}

const { title, description, ogType = 'website', robots } = Astro.props;

const canonicalHref = pageUrl(Astro.url.pathname);
const ogImageURL = `${SITE_ORIGIN}/og_image.png`;

const robotsContent =
  robots ?? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const markdownURL = markdownTwinUrl(Astro.url.pathname);
---

<!-- Canonical -->
<link rel="canonical" href={canonicalHref} />

<!-- Indexing -->
<meta name="robots" content={robotsContent} />

<!-- Plain-text twin of this page, for agents and answer engines -->
{markdownURL && (
  <link rel="alternate" type="text/markdown" href={markdownURL} title="Markdown version" />
)}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:alt" content="Professional headshot of Henrik Soderlund on a dark background with name and title text" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Henrik Söderlund" />
<meta property="og:locale" content="en_AU" />

{ogType === 'profile' && (
  <>
    <meta property="profile:first_name" content="Henrik" />
    <meta property="profile:last_name" content="Söderlund" />
    <meta property="profile:username" content="henkisdabro" />
  </>
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@henkisdabro" />
<meta name="twitter:creator" content="@henkisdabro" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content="Professional headshot of Henrik Soderlund on a dark background with name and title text" />

<!-- SEO Verification -->
<meta name="google-site-verification" content="TVUdAh0RA_yjsXKKjybCDe7JsKnXBhYFbcRPoJy03rc" />
<meta name="ahrefs-site-verification" content="bc08e3a49be838e1d8cfa2eabc5bf8e7d833c572e09db62742db9ed9917d6ada" />
