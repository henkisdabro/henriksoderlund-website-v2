---
---

<button
  class="icon-button theme-toggle"
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <!-- Sun icon (shown in dark mode - click to go light) -->
  <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <!-- Moon icon (shown in light mode - click to go dark) -->
  <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: fixed;
    top: 27px;
    right: 35px;
    z-index: 1000;
  }

  /* The moon is the default and the sun is revealed only by the dark palette.
     data-theme is stamped by JS, so it can be absent entirely (crawler, no JS,
     localStorage throwing) - gating both icons on the attribute showed both at
     once in that state. Defaulting to one icon and layering the dark states on
     top keeps exactly one visible in all three states. */
  .theme-icon--sun {
    display: none;
  }

  .theme-icon--moon {
    display: block;
  }

  :global([data-theme="dark"]) .theme-icon--sun {
    display: block;
  }

  :global([data-theme="dark"]) .theme-icon--moon {
    display: none;
  }

  /* Unstamped dark: matches theme.css's :root:not([data-theme="light"]) guard,
     so an explicit light choice still keeps the moon. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-icon--sun {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .theme-icon--moon {
      display: none;
    }
  }

  /* Ultrawide gutter positioning - stay next to GitHub/LinkedIn */
  @media (min-width: 1400px) {
    .theme-toggle {
      right: max(17px, calc((100vw - 1200px) / 2 - 83px));
    }
  }

  /* Mobile positioning */
  @media (max-width: 768px) {
    .theme-toggle {
      right: 30px;
    }
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    // The head script resolves the theme before this button exists, so the
    // theme-neutral server-rendered name is specialised here, once, without a
    // repaint - and again on every `site:theme`. The label is this component's
    // to own; the layout only announces which theme is now in force.
    function syncLabel(t) {
      const current = t || document.documentElement.getAttribute('data-theme');
      // No resolved theme means the head script never ran, and the neutral
      // server-rendered name is then the only accurate one.
      if (current !== 'dark' && current !== 'light') return;
      const next = current === 'dark' ? 'light' : 'dark';
      btn.setAttribute('aria-label', 'Switch to ' + next + ' mode');
      btn.setAttribute('title', 'Switch to ' + next + ' mode');
    }

    syncLabel();
    document.addEventListener('site:theme', function (event) {
      syncLabel(event.detail && event.detail.theme);
    });

    // A request, not a state change: the layout decides what the next theme is.
    btn.addEventListener('click', function () {
      document.dispatchEvent(new CustomEvent('site:theme:toggle'));
    });
  })();
</script>
