---
import SEO from '../components/SEO.astro';
import NavigationBox from '../components/NavigationBox.astro';
import GitHubLink from '../components/GitHubLink.astro';
import LinkedInLink from '../components/LinkedInLink.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import { GITHUB_URL, LINKEDIN_URL, CALENDLY_URL, CONTACT_EMAIL } from '../data/links';
import { consultationData } from '../data/consultation';
import { ENTITIES, PERTH_GEO } from '../data/entities';
import { pageUrl } from '../utils/pageUrl';
import '../styles/theme.css';
import '../styles/index.css';
import '../styles/App.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'profile' | 'website';
  /** Which sitewide entity this page is primarily about. */
  primaryEntity?: 'person' | 'practice';
  /** Keys from `ENTITIES` to emit as `mentions` on the page's WebPage node. */
  mentions?: string[];
  /**
   * schema.org type for the per-page node. Defaults to `WebPage`, or
   * `ProfilePage` on the homepage, which is about the Person.
   */
  pageSchemaType?: 'WebPage' | 'ProfilePage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  /** Analytics content dimension. Defaults to a slug derived from the pathname. */
  pageType?: string;
  /** Passed straight to SEO.astro, which owns the default. */
  robots?: string;
}

const {
  title,
  description,
  ogType = 'website',
  primaryEntity = 'person',
  mentions = [],
  pageSchemaType,
  pageType,
  robots,
} = Astro.props;

const isHomepage = Astro.url.pathname === '/';

const resolvedPageSchemaType = pageSchemaType ?? (isHomepage ? 'ProfilePage' : 'WebPage');

// Derived so pages need not pass it: '/' is 'home', everything else is its
// path slugified to snake_case ('/perth-analytics-consultant' -> 'perth_analytics_consultant').
const resolvedPageType = pageType ?? (isHomepage
  ? 'home'
  : Astro.url.pathname.replace(/^\/+|\/+$/g, '').replace(/[^A-Za-z0-9]+/g, '_').toLowerCase() || 'home');
const pageURL = pageUrl(Astro.url.pathname);

const personSchemaJSON = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.henriksoderlund.com/#person",
  "name": "Henrik Söderlund",
  "url": "https://www.henriksoderlund.com/",
  "image": "https://www.henriksoderlund.com/og_image.png",
  "jobTitle": "Technology Leader & Automation Architect",
  "description": "Technology Leader and Automation Architect building automation, analytics infrastructure, and digital products that free teams to focus on higher-value work. Agency founder and enterprise operator based in Perth, Australia.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Perth",
    "addressRegion": "WA",
    "addressCountry": "AU"
  },
  "hasOccupation": {
    "@type": "Occupation",
    "name": "Independent AI & Technology Consultant",
    "description": "Independent consultant delivering AI automation, analytics infrastructure, and digital products",
    "occupationLocation": {
      "@type": "City",
      "name": "Perth"
    }
  },
  "knowsAbout": [
    "Artificial Intelligence",
    "Workflow Automation",
    "AI Coding Assistants",
    "Technology Leadership",
    "Analytics Infrastructure",
    "Server-Side Tracking",
    "Google Analytics",
    "Google Tag Manager",
    "Measurement Frameworks",
    "Cloudflare Workers",
    "LLM API Integration",
    "Digital Products",
    "Programmatic Advertising",
    "Marketing Technology",
    "Data Pipeline Architecture",
    "Team Building & Mentoring",
    "Process Automation",
    "Python Programming",
    "React Development"
  ],
  "alumniOf": [
    {
      "@type": "CollegeOrUniversity",
      "name": "Lund University",
      "sameAs": "https://www.lu.se/",
      "department": {
        "@type": "EducationalOrganization",
        "name": "Malmö Academy of Music"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Malmö",
        "addressCountry": "SE"
      }
    }
  ],
  "knowsLanguage": [
    {
      "@type": "Language",
      "name": "English",
      "alternateName": "en"
    },
    {
      "@type": "Language",
      "name": "Swedish",
      "alternateName": "sv"
    }
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "professional enquiries",
    "url": "https://www.henriksoderlund.com/contact"
  },
  "sameAs": [
    GITHUB_URL,
    LINKEDIN_URL
  ],
  "award": [
    "MFA Changer Recognition 2024 - Initiative Australia",
    "Advertising+Marketing AOTY Best Local Media Agency 2021 - Creme Digital"
  ]
});

const practiceSchemaJSON = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://www.henriksoderlund.com/#practice",
  // Deliberately distinct from the `Service` node on /consultancy: that node is
  // the offering, this one is the registered practice that provides it.
  "name": "Henrik Söderlund - Strategic Technology Consultancy",
  "taxID": "96 522 684 594",
  "identifier": {
    "@type": "PropertyValue",
    "propertyID": "ABN",
    "value": "96522684594"
  },
  "url": "https://www.henriksoderlund.com/consultancy",
  "description": consultationData.hero.subtitle,
  "founder": {
    "@id": "https://www.henriksoderlund.com/#person"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Perth",
    "addressRegion": "WA",
    "addressCountry": "AU"
  },
  // No street address or postcode: this is a service-area practice with no
  // shopfront, so only the locality is factual.
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": PERTH_GEO.latitude,
    "longitude": PERTH_GEO.longitude
  },
  "image": "https://www.henriksoderlund.com/og_image.png",
  "logo": "https://www.henriksoderlund.com/og_image.png",
  "email": CONTACT_EMAIL,
  "telephone": "+61490961257",
  // A solo practice with no shopfront: the service area is modelled as a
  // GeoCircle over the Perth metropolitan area rather than as a street address,
  // which is what schema.org expects of a service-area business.
  "areaServed": [
    { ...ENTITIES.perth },
    { ...ENTITIES.westernAustralia },
    { "@type": "Country", "name": "Australia", "sameAs": "https://www.wikidata.org/wiki/Q408" },
    {
      "@type": "GeoCircle",
      "geoMidpoint": {
        "@type": "GeoCoordinates",
        "latitude": PERTH_GEO.latitude,
        "longitude": PERTH_GEO.longitude
      },
      "geoRadius": "60000"
    }
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "17:00"
    }
  ],
  "currenciesAccepted": "AUD",
  "knowsLanguage": [
    { "@type": "Language", "name": "English", "alternateName": "en" },
    { "@type": "Language", "name": "Swedish", "alternateName": "sv" }
  ],
  "knowsAbout": [
    { ...ENTITIES.googleAnalytics },
    { ...ENTITIES.googleTagManager },
    { ...ENTITIES.serverSideTagging },
    { ...ENTITIES.bigQuery },
    { ...ENTITIES.lookerStudio },
    { ...ENTITIES.cloudflareWorkers }
  ],
  "serviceType": "AI Automation & Technology Consulting",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Consulting Services",
    "itemListElement": consultationData.services.pillars.map(pillar => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": pillar.name,
        "description": pillar.description
      }
    }))
  },
  "availableChannel": {
    "@type": "ServiceChannel",
    "serviceUrl": CALENDLY_URL,
    "availableLanguage": [
      { "@type": "Language", "name": "English", "alternateName": "en" },
      { "@type": "Language", "name": "Swedish", "alternateName": "sv" }
    ]
  },
  "sameAs": [
    GITHUB_URL,
    LINKEDIN_URL
  ]
});

// Per-page WebPage node. This is what ties a given URL to the sitewide
// entities: without it, `#person`, `#practice` and `#website` float free of the
// page a crawler is actually looking at. `mentions` carries the Wikidata-linked
// technology entities so an answer engine can resolve "GA4" or "server-side
// tagging" to a known thing rather than to a string.
const webPageSchemaJSON = JSON.stringify({
  "@context": "https://schema.org",
  "@type": resolvedPageSchemaType,
  "@id": `${pageURL}#webpage`,
  "url": pageURL,
  "name": title,
  "description": description,
  "inLanguage": "en-AU",
  "isPartOf": { "@id": "https://www.henriksoderlund.com/#website" },
  "about": {
    "@id": primaryEntity === 'practice'
      ? "https://www.henriksoderlund.com/#practice"
      : "https://www.henriksoderlund.com/#person"
  },
  // ProfilePage requires the profiled entity on `mainEntity`.
  ...(resolvedPageSchemaType === 'ProfilePage' && {
    mainEntity: { "@id": "https://www.henriksoderlund.com/#person" },
  }),
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": "https://www.henriksoderlund.com/og_image.png",
    "width": 1200,
    "height": 630
  },
  ...(mentions.length > 0 && {
    mentions: mentions.map(key => ENTITIES[key]).filter(Boolean),
  }),
});

const websiteSchemaJSON = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.henriksoderlund.com/#website",
  "name": "Henrik Söderlund - Technology Leader & Automation Architect",
  "url": "https://www.henriksoderlund.com/",
  "description": "The personal website of Henrik Söderlund, a Technology Leader and Automation Architect based in Perth, Australia.",
  "author": {
    "@id": "https://www.henriksoderlund.com/#person"
  },
  "publisher": {
    "@id": "https://www.henriksoderlund.com/#practice"
  }
});

const calendlyHost = new URL(CALENDLY_URL).hostname;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />

    <!-- Theme detection - must run before any paint to prevent FOUC -->
    <script is:inline data-csp>
      (function() {
        // Every storage and matchMedia access is guarded: Safari's "Block All
        // Cookies", Firefox with storage disabled and locked-down kiosk
        // profiles all throw SecurityError on localStorage. An unguarded throw
        // here would abort this IIFE before it binds the toggle-request
        // listener, leaving the theme toggle inert for the whole session.
        // (The page itself still renders: theme.css defines the full palette on
        // bare :root, so a missing data-theme falls back to the light theme.)
        function readStoredTheme() {
          try {
            const stored = localStorage.getItem('theme');
            return stored === 'dark' || stored === 'light' ? stored : null;
          } catch { return null; }
        }

        function writeStoredTheme(t) {
          try { localStorage.setItem('theme', t); } catch { /* storage unavailable */ }
        }

        function prefersDark() {
          try { return window.matchMedia('(prefers-color-scheme: dark)').matches; } catch { return false; }
        }

        const theme = readStoredTheme() || (prefersDark() ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);

        // This layout owns the theme and nothing else. Anything that has to
        // react to a change - the toggle's accessible name, the contact form's
        // Turnstile widget - listens for `site:theme` and owns its own
        // reaction, so this script never has to know which of them is on the
        // page. CustomEvent needs no eval and no inline handler attribute, so
        // it costs the CSP nothing.
        function setTheme(t) {
          // Enable transitions only during theme switch
          document.documentElement.classList.add('theme-transitioning');
          document.documentElement.setAttribute('data-theme', t);
          writeStoredTheme(t);
          setTimeout(function() { document.documentElement.classList.remove('theme-transitioning'); }, 350);
          document.dispatchEvent(new CustomEvent('site:theme', { detail: { theme: t } }));
        }

        // The toggle button does not exist yet when this runs in <head>, so it
        // asks for a change by event rather than being wired up from here.
        document.addEventListener('site:theme:toggle', function() {
          const current = document.documentElement.getAttribute('data-theme');
          setTheme(current === 'dark' ? 'light' : 'dark');
        });

        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
            if (!readStoredTheme()) {
              setTheme(e.matches ? 'dark' : 'light');
            }
          });
        } catch { /* matchMedia unavailable */ }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Preload critical fonts to reduce render-blocking -->
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />

    <SEO title={title} description={description} ogType={ogType} robots={robots} />

    <!-- Structured Data - Person Schema -->
    <script type="application/ld+json" set:html={personSchemaJSON} is:inline></script>

    <!-- Structured Data - ProfessionalService Schema -->
    <script type="application/ld+json" set:html={practiceSchemaJSON} is:inline></script>

    <!-- Structured Data - Website Schema -->
    <script type="application/ld+json" set:html={websiteSchemaJSON} is:inline></script>

    <!-- Structured Data - WebPage Schema (per page) -->
    <script type="application/ld+json" set:html={webPageSchemaJSON} is:inline></script>

    <!-- Page-specific JSON-LD slot -->
    <slot name="head" />

    <link rel="preconnect" href="https://load.sgtm.henriksoderlund.com/" />
    <link rel="preconnect" href="https://api.fouanalytics.com" crossorigin />
    <link rel="dns-prefetch" href="https://load.sgtm.henriksoderlund.com/" />
    <link rel="dns-prefetch" href="https://api.fouanalytics.com" />

    <!-- Initialize dataLayer before GTM -->
    <script is:inline data-csp define:vars={{ pageType: resolvedPageType }}>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'dl_init',
        environment: (location.hostname === 'localhost' || location.hostname === '127.0.0.1' || location.hostname.endsWith('.workers.dev')) ? 'development' : 'production',
        page_type: pageType
      });
    </script>

    <!-- Google Tag Manager (async, loaded immediately) -->
    <script is:inline data-csp>
      if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1' && !location.hostname.endsWith('.workers.dev')) {
        const loadGTM = function() {
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            const f = d.getElementsByTagName(s)[0], j = d.createElement(s);
            j.async = true;
            j.src = "https://load.sgtm.henriksoderlund.com/dz4d7tyirczbv.js?" + i;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', '6at4snq=aWQ9R1RNLUZXUjQ%3D&omNe=daQSaS');
        }
        // Loaded straight away: the injected tag is already async and the
        // loader host is preconnected, so deferring only lost sessions that
        // ended before the main thread went idle.
        loadGTM();
      }
    </script>

    <!-- View Transitions -->
    <style is:global>
      @view-transition { navigation: auto; }
      ::view-transition-old(root) { animation: none; }
      ::view-transition-new(root) { animation: none; }

      /* Skip link - visually hidden until it takes keyboard focus (WCAG 2.4.1). */
      .skip-link {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 2000;
        padding: 0.75rem 1.25rem;
        background: var(--color-bg-elevated);
        color: var(--color-text-primary);
        border: 1px solid var(--color-border-primary);
        border-radius: 0 0 6px 0;
        font: inherit;
        text-decoration: none;
        transform: translateY(-150%);
      }

      .skip-link:focus {
        transform: translateY(0);
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
      }

      /* The skip target is programmatically focusable, so suppress its ring. */
      .main-content:focus {
        outline: none;
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://load.sgtm.henriksoderlund.com/ns.html?id=GTM-FWR4" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <noscript><img src="https://api.fouanalytics.com/api/noscript-6686ht0xp1ec4dc5q5z4.gif" alt="Fou Analytics tracking pixel" width="1" height="1" /></noscript>

    <div class="app">
      <NavigationBox />
      <ThemeToggle />
      <GitHubLink />
      <LinkedInLink />

      <main class="main-content" id="main" tabindex="-1">
        <slot />
      </main>

      <Footer />
    </div>

    <!-- Delegated interaction tracking -->
    <script is:inline data-csp define:vars={{ calendlyHost }}>
      (function () {
        const CALENDLY_HOST = calendlyHost;

        // Every call site sits inside the delegated click handler's own
        // try/catch, which is the authoritative boundary.
        function push(payload) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(payload);
        }

        function slug(value) {
          return String(value || '').trim().replace(/[^A-Za-z0-9]+/g, '_').replace(/^_+|_+$/g, '').toLowerCase();
        }

        function labelOf(el) {
          let text = (el.textContent || '').replace(/\s+/g, ' ').trim();
          if (!text) text = el.getAttribute('aria-label') || el.getAttribute('title') || '';
          return text.slice(0, 100);
        }

        // Derived from where the element sits, not from a hardcoded list of pages.
        // Every branch falls back to 'unknown': slug() returns '' for a value with
        // no alphanumerics, and an empty GA4 dimension is not debuggable.
        function locationOf(el) {
          const region = el.closest('section, article, header, footer, nav, aside, main');
          if (!region) return 'page';
          const key = region.id || region.getAttribute('aria-label') || (region.classList && region.classList[0]);
          return key ? (slug(key) || 'unknown') : 'page';
        }

        // Capture phase on `document`: a capturing listener here runs before the
        // toggle button's own at-target handler, which is what flips data-theme,
        // so this still reads the pre-click theme. Moving this listener off
        // capture would silently invert `theme_selected`.
        document.addEventListener('click', function (event) {
          try {
            const target = event.target;
            if (!target || typeof target.closest !== 'function') return;

            // One ancestor walk covers both cases; the toggle is never an anchor.
            const hit = target.closest('a[href], #theme-toggle');
            if (!hit) return;

            if (hit.id === 'theme-toggle') {
              const current = document.documentElement.getAttribute('data-theme');
              push({ event: 'theme_toggle', theme_selected: current === 'dark' ? 'light' : 'dark' });
              return;
            }

            // HTMLAnchorElement implements the URL decomposition attributes, so
            // `protocol`, `hostname` and `href` are already absolute and parsed.
            const anchor = hit;

            if (anchor.protocol === 'mailto:') {
              push({ event: 'email_click', cta_location: locationOf(anchor) });
              return;
            }
            if (anchor.protocol !== 'http:' && anchor.protocol !== 'https:') return;

            if (anchor.hostname === CALENDLY_HOST) {
              push({
                event: 'booking_start',
                link_url: anchor.href,
                link_text: labelOf(anchor),
                cta_location: locationOf(anchor)
              });
              return;
            }

            if (anchor.hostname !== location.hostname) {
              push({
                event: 'outbound_click',
                link_domain: anchor.hostname,
                link_url: anchor.href,
                link_text: labelOf(anchor)
              });
            }
          } catch { /* never throw out of a click handler */ }
        }, true);
      })();
    </script>
  </body>
</html>
