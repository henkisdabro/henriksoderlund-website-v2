---
export const prerender = true;
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { expertiseData } from '../data/expertise';
import { buildsData, TEASER_COUNT } from '../data/builds';
import { sectionIcons } from '../utils/sectionIcons';

const { skills } = expertiseData;
import ascribeImage from '../assets/images/screenshots/ascribe.webp';
import sandcastleKitImage from '../assets/images/screenshots/sandcastle-kit.webp';
import automationDiagramImage from '../assets/images/screenshots/automation-diagram.webp';

const imageMap: Record<string, ImageMetadata> = {
  ascribeImage,
  sandcastleKitImage,
  automationDiagramImage,
};
---

<BaseLayout
  mentions={[
    'claudeCode',
    'openAiCodex',
    'modelContextProtocol',
    'largeLanguageModel',
    'googleAnalytics',
    'googleTagManager',
    'serverSideTagging',
    'metaConversionsApi',
    'bigQuery',
    'lookerStudio',
    'powerBi',
    'powerQuery',
    'python',
    'cloudflareWorkers',
    'programmaticAdvertising',
    'realTimeBidding',
    'googleAds',
    'googleSearchConsole',
    'jsonLd',
    'ascribe',
    'sandcastleKit',
  ]}
  title="AI Solutions, Automation & Measurement | Henrik Söderlund"
  description="From AI automation and custom web platforms to GA4, server-side tagging and BigQuery reporting - plus building and leading teams. Perth, Australia."
>
  <div class="expertise-page">
    <h1>Expertise</h1>

    <section class="consultancy-section">
      <h2 id="overview"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.rocket} />{expertiseData.intro.title}</h2>
      <p>{expertiseData.intro.paragraph}</p>
    </section>

    <section class="builds-teaser-section">
      <h2 id="what-i-build"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.layers} />{buildsData.title}</h2>
      <div class="builds-teaser">
        {buildsData.projects.slice(0, TEASER_COUNT).map(project => (
          <a
            href={`/builds#${project.id}`}
            class="builds-teaser-tile"
            style={`--card-accent-light: ${project.accentColour}${project.accentColourDark ? `; --card-accent-dark: ${project.accentColourDark}` : ''}`}
          >
            <span class="builds-teaser-type">{project.type}</span>
            <h3>{project.title}</h3>
            <p>{project.tagline}</p>
            <span class="builds-teaser-peek" aria-hidden="true">
              <Image src={imageMap[project.image]} alt="" width={520} loading="lazy" />
            </span>
          </a>
        ))}
      </div>
      <p class="builds-teaser-more"><a href="/builds">See all builds &rarr;</a></p>
    </section>

    <section class="skills-section">
      <h2 id="technical-skills"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.wrench} />{skills.title}</h2>
      <div class="skill-rows">
        {skills.groups.map(group => (
          <div class="skill-row">
            <div class="skill-row-head">
              <h3>{group.name}</h3>
              {group.proof && <a href={group.proof.href} class="skill-proof">Seen in {group.proof.text} &rarr;</a>}
            </div>
            <div class="skill-row-body">
              <ul class="skill-line">
                {group.skills.map(skill => (
                  <li class={group.core?.includes(skill) ? 'skill-core' : undefined}>{skill}</li>
                ))}
              </ul>
              {group.platforms && (
                <dl class="skill-platforms">
                  {group.platforms.map(set => (
                    <div>
                      <dt>{set.label}</dt>
                      <dd>{set.names.join(', ')}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {group.description && <p class="skill-row-note">{group.description}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <p class="page-crosslink">
      Perth or Western Australia, and the measurement side is what you need? See
      <a href="/perth-analytics-consultant">GA4 and server-side tagging in Perth</a>.
    </p>
  </div>
</BaseLayout>

<style is:global>
/* Skills Page Styles */
.consultancy-section {
  margin-bottom: 2rem;
}

.consultancy-section h2,
.builds-teaser-section h2,
.skills-section h2 {
  font-size: 2rem;
  margin-bottom: 1rem;
  color: var(--color-text-heading);
}

.skills-section {
  margin-bottom: 3rem;
}

.skill-proof {
  font-size: 0.8rem;
  font-weight: 500;
}

/* One row per group, terms as a plain line of text. */
.skill-rows {
  border-top: 1px solid var(--color-border-primary);
}

.skill-row {
  display: grid;
  grid-template-columns: 11.5rem minmax(0, 1fr);
  gap: 1.5rem;
  padding: 1.25rem 0;
  border-bottom: 1px solid var(--color-border-primary);
}

.skill-row-head h3 {
  font-size: 1.05rem;
  line-height: 1.35;
  color: var(--color-text-heading);
  margin: 0 0 0.35rem;
}

.skill-line {
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: 0.92rem;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.skill-line li {
  display: inline;
}

.skill-line li:not(:last-child)::after {
  content: '\00b7';
  margin: 0 0.5rem;
  color: var(--color-text-muted);
  font-weight: 400;
}

.skill-core {
  font-weight: 700;
  color: var(--color-text-heading);
}

.skill-platforms {
  margin: 0.75rem 0 0;
  display: grid;
  gap: 0.25rem;
  font-size: 0.87rem;
  line-height: 1.6;
}

.skill-platforms div {
  display: grid;
  grid-template-columns: 7.5rem minmax(0, 1fr);
  gap: 0.75rem;
}

.skill-platforms dt {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  line-height: 1.95;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--color-text-muted);
}

.skill-platforms dd {
  margin: 0;
  color: var(--color-text-secondary);
}

.skill-row-note {
  margin: 0.75rem 0 0;
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--color-text-tertiary);
}

/* Builds teaser - the builds themselves live on /builds */
.builds-teaser-section {
  margin-top: 2rem;
  margin-bottom: 2rem;
}

.builds-teaser {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 0.75rem;
}

/* Each tile shows its build's screenshot peeking over the bottom edge, tilted
   like a print on a desk; hover straightens it and slides it up into view.
   --card-accent only tints the glow behind the screenshot. */
.builds-teaser-tile {
  --card-accent: var(--card-accent-light);
  display: flex;
  flex-direction: column;
  background: var(--color-bg-code);
  border: 1px solid var(--color-border-primary);
  border-radius: 12px;
  padding: 1.25rem 1.25rem 0;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

:root[data-theme="dark"] .builds-teaser-tile {
  --card-accent: var(--card-accent-dark, var(--card-accent-light));
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .builds-teaser-tile {
    --card-accent: var(--card-accent-dark, var(--card-accent-light));
  }
}

.builds-teaser-tile:hover {
  border-color: var(--color-text-muted);
  box-shadow: 0 10px 28px var(--color-shadow-heavy);
  text-decoration: none;
}

.builds-teaser-type {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--color-text-muted);
}

.builds-teaser-tile h3 {
  font-size: 1.15rem;
  margin: 0.3rem 0 0.4rem;
  color: var(--color-text-heading);
}

.builds-teaser-tile p {
  font-size: 0.9rem;
  color: var(--color-text-tertiary);
  line-height: 1.5;
  margin: 0;
}

.builds-teaser-peek {
  display: block;
  height: 7rem;
  margin-top: auto;
  padding-top: 1.25rem;
}

.builds-teaser-peek img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--color-border-primary);
  border-radius: 8px;
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--card-accent) 0%, transparent),
              0 -4px 22px color-mix(in srgb, var(--card-accent) 22%, transparent);
  transform: translateY(1.5rem) rotate(-3deg);
  transform-origin: 20% 0;
  transition: transform 0.45s cubic-bezier(0.2, 0.9, 0.25, 1.15), box-shadow 0.3s ease;
}

.builds-teaser-tile:hover .builds-teaser-peek img,
.builds-teaser-tile:focus-visible .builds-teaser-peek img {
  transform: translateY(0.1rem) rotate(0deg);
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--card-accent) 45%, transparent),
              0 -6px 30px color-mix(in srgb, var(--card-accent) 38%, transparent);
}

.builds-teaser-more {
  margin-top: 1rem;
  font-weight: 600;
}

@media (prefers-reduced-motion: reduce) {
  .builds-teaser-tile,
  .builds-teaser-peek img {
    transition: none;
  }
}

/* Expertise page mobile responsive */
@media (max-width: 768px) {
  .consultancy-section h2,
  .builds-teaser-section h2,
  .skills-section h2 {
    font-size: 1.3em;
  }

  .skill-row {
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

  .skill-platforms div {
    grid-template-columns: 1fr;
    gap: 0;
  }
}
</style>
