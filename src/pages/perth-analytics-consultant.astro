---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { perthAnalyticsData } from '../data/perthAnalytics';
import { CALENDLY_URL } from '../data/links';
import { sectionIcons } from '../utils/sectionIcons';
import { ENTITIES, PERTH_GEO } from '../data/entities';
import { nodeId, pageUrl } from '../utils/pageUrl';

const canonicalUrl = pageUrl(Astro.url.pathname);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": nodeId(Astro.url.pathname, 'service'),
  "name": "GA4 and Server-Side Tagging Consultancy - Perth, Western Australia",
  "description": "Google Analytics 4 implementation, remediation and server-side Google Tag Manager deployment for businesses in Perth and Western Australia. First-party tracking, conversion APIs, BigQuery and Looker Studio reporting.",
  "url": canonicalUrl,
  "provider": {
    "@id": "https://www.henriksoderlund.com/#practice"
  },
  "serviceType": "Analytics Implementation & Server-Side Tagging",
  "areaServed": [
    { ...ENTITIES.perth },
    { ...ENTITIES.westernAustralia },
    { "@type": "Country", "name": "Australia", "sameAs": "https://www.wikidata.org/wiki/Q408" },
    {
      "@type": "GeoCircle",
      "geoMidpoint": {
        "@type": "GeoCoordinates",
        "latitude": PERTH_GEO.latitude,
        "longitude": PERTH_GEO.longitude
      },
      "geoRadius": "60000"
    }
  ],
  // No `about`: schema.org defines it on CreativeWork, not Service. The
  // technologies are carried by the page's WebPage node as `mentions`.
  // The four-stage ladder shown on the page, each stage a catalog of the
  // services listed under it.
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Analytics Services",
    "itemListElement": perthAnalyticsData.ladder.stages.map(stage => ({
      "@type": "OfferCatalog",
      "name": stage.name,
      "description": stage.blurb,
      "itemListElement": stage.items.map(item => ({
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": item }
      }))
    }))
  },
  "availableChannel": {
    "@type": "ServiceChannel",
    "serviceUrl": CALENDLY_URL,
    "availableLanguage": [
      { "@type": "Language", "name": "English", "alternateName": "en" },
      { "@type": "Language", "name": "Swedish", "alternateName": "sv" }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": nodeId(Astro.url.pathname, 'faq'),
  // Anchors the FAQ to the page's own WebPage node emitted by BaseLayout.
  "isPartOf": { "@id": nodeId(Astro.url.pathname, 'webpage') },
  "mainEntity": perthAnalyticsData.faq.items.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

---

<BaseLayout
  primaryEntity="practice"
  mainEntity={{ "@type": "Service", "@id": serviceSchema["@id"] }}
  mentions={[
    'googleAnalytics',
    'googleTagManager',
    'serverSideTagging',
    'metaConversionsApi',
    'bigQuery',
    'lookerStudio',
    'powerBi',
    'powerQuery',
    'python',
    'googleAds',
    'cloudflareWorkers',
    'ascribe',
    'perth',
    'westernAustralia',
  ]}
  title="Perth Analytics Consultant - GA4 & Server-Side Tracking | Henrik Söderlund"
  description="Independent GA4 and server-side tagging consultant in Perth, Western Australia. First-party tracking, conversion APIs, BigQuery and CRM-reconciled reporting."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </Fragment>

  <div class="perth-page">
    <section class="perth-hero">
      <h1>{perthAnalyticsData.hero.title}</h1>
      <p class="hero-subtitle">{perthAnalyticsData.hero.subtitle}</p>
      <p>{perthAnalyticsData.hero.statement}</p>
      <ul class="perth-signals">
        {perthAnalyticsData.hero.signals.map(signal => (
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            {signal}
          </li>
        ))}
      </ul>
    </section>

    <!-- Spine: the four-stage ladder, covering the whole practice -->
    <section class="perth-section">
      <h2 id="how-the-work-stacks-up"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.layers} />{perthAnalyticsData.ladder.title}</h2>
      <p class="perth-intro">{perthAnalyticsData.ladder.intro}</p>
      <ol class="perth-ladder">
        {perthAnalyticsData.ladder.stages.map((stage, i) => (
          <li class="perth-ladder-stage">
            <div class="ladder-marker" aria-hidden="true"><span>{i + 1}</span></div>
            <h3>{stage.name}</h3>
            <p class="ladder-blurb">{stage.blurb}</p>
            <ul>
              {stage.items.map(item => <li>{item}</li>)}
            </ul>
          </li>
        ))}
      </ol>
      <p class="perth-note">{perthAnalyticsData.ladder.note}</p>
    </section>

    <!-- Trust: checkable artefacts, not adjectives -->
    <section class="perth-section">
      <h2 id="proof"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.gitBranch} />{perthAnalyticsData.proof.title}</h2>
      <p class="perth-intro">{perthAnalyticsData.proof.intro}</p>
      <div class="perth-grid perth-grid--3">
        {perthAnalyticsData.proof.items.map(item => (
          <div class="perth-tile">
            <span class="tile-kind">{item.kind}</span>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
      <p class="perth-callout">{perthAnalyticsData.proof.selfHosted}</p>
    </section>

    <section class="perth-section">
      <h2 id="who-this-is-for"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.users} />{perthAnalyticsData.audience.title}</h2>
      <p class="perth-intro">{perthAnalyticsData.audience.intro}</p>
      <div class="perth-grid perth-grid--2">
        {perthAnalyticsData.audience.profiles.map(profile => (
          <div class="perth-tile">
            <h3>{profile.label}</h3>
            <p>{profile.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="perth-section">
      <h2 id="what-the-work-covers"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.wrench} />{perthAnalyticsData.services.title}</h2>
      <p class="perth-intro">{perthAnalyticsData.services.intro}</p>
      <div class="perth-accordion">
        {perthAnalyticsData.services.groups.map((group, i) => (
          <details class="perth-fold" open={i === 0}>
            <summary>
              <span class="fold-index" aria-hidden="true">{i + 1}</span>
              <span class="fold-heading">
                <h3>{group.name}</h3>
                <span class="fold-sub">{group.description}</span>
              </span>
            </summary>
            <ul class="fold-list">
              {group.items.map(item => <li>{item}</li>)}
            </ul>
          </details>
        ))}
      </div>
    </section>

    <section class="perth-section">
      <h2 id="symptoms"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.trendingUp} />{perthAnalyticsData.diagnostics.title}</h2>
      <p class="perth-intro">{perthAnalyticsData.diagnostics.intro}</p>
      <div class="perth-accordion">
        {perthAnalyticsData.diagnostics.items.map((item, i) => (
          <details class="perth-fold" open={i === 0}>
            <summary>
              <span class="fold-heading"><h3>{item.symptom}</h3></span>
            </summary>
            <div class="fold-pair">
              <p><span class="pair-label">Usual cause</span>{item.cause}</p>
              <p><span class="pair-label pair-label--fix">Fix</span>{item.fix}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- The page's only diagram: server-side tagging is the one thing hard to explain in a sentence -->
    <section class="perth-section">
      <h2 id="how-server-side-tagging-works"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.cpu} />How server-side tagging changes the path</h2>
      <p class="perth-intro">Four requests leave the browser and most get blocked. One request leaves instead, to a subdomain of your own domain, and the forwarding happens server-side.</p>
      <div class="perth-diagram">
        <svg viewBox="0 0 720 178" role="img" aria-label="Diagram comparing browser-side tagging, where three of four vendor requests are blocked, with server-side tagging, where a single request to a first-party subdomain is forwarded on to all four vendors.">
          <text x="0" y="12" class="dg-eyebrow">BEFORE</text>
          <rect x="0" y="22" width="104" height="48" rx="6" class="dg-box-soft" />
          <text x="52" y="42" text-anchor="middle" class="dg-strong">Visitor</text>
          <text x="52" y="58" text-anchor="middle" class="dg-small">browser</text>
          <g class="dg-line-dead" fill="none">
            <path d="M104 36 C 150 36, 165 22, 210 22" />
            <path d="M104 42 C 150 42, 165 40, 210 40" />
            <path d="M104 50 C 150 50, 165 58, 210 58" />
            <path d="M104 56 C 150 56, 165 76, 210 76" />
          </g>
          <g class="dg-cross">
            <path d="M152 16 l10 10 M162 16 l-10 10" />
            <path d="M152 35 l10 10 M162 35 l-10 10" />
            <path d="M152 64 l10 10 M162 64 l-10 10" />
          </g>
          <rect x="210" y="12" width="150" height="20" rx="4" class="dg-box-blocked" />
          <text x="221" y="26" class="dg-blocked">GA4 - blocked</text>
          <rect x="210" y="34" width="150" height="20" rx="4" class="dg-box-blocked" />
          <text x="221" y="48" class="dg-blocked">Meta - blocked</text>
          <rect x="210" y="56" width="150" height="20" rx="4" class="dg-box-blocked" />
          <text x="221" y="70" class="dg-blocked">Ads - blocked</text>
          <rect x="210" y="78" width="150" height="20" rx="4" class="dg-box-soft" />
          <text x="221" y="92" class="dg-small">TikTok - arrives</text>

          <line x1="0" y1="116" x2="720" y2="116" class="dg-rule" />

          <text x="0" y="136" class="dg-eyebrow dg-eyebrow-on">AFTER</text>
          <rect x="0" y="146" width="104" height="30" rx="6" class="dg-box-soft" />
          <text x="52" y="165" text-anchor="middle" class="dg-strong">Visitor</text>
          <path d="M104 161 L 152 161" class="dg-line-live" fill="none" />
          <path d="M146 156 l7 5 l-7 5" class="dg-arrow" />
          <rect x="153" y="144" width="188" height="34" rx="6" class="dg-box-key" />
          <text x="247" y="158" text-anchor="middle" class="dg-strong">data.yourdomain.com.au</text>
          <text x="247" y="172" text-anchor="middle" class="dg-small">your domain, your rules</text>
          <path d="M341 161 L 392 161" class="dg-line-live" fill="none" />
          <path d="M386 156 l7 5 l-7 5" class="dg-arrow" />
          <rect x="393" y="146" width="326" height="30" rx="5" class="dg-box-soft" />
          <text x="407" y="165" class="dg-small">GA4, Meta CAPI, Google Ads, TikTok - all four arrive</text>
        </svg>
      </div>
    </section>

    <section class="perth-section">
      <h2 id="deliverables"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.sparkles} />{perthAnalyticsData.deliverables.title}</h2>
      <p class="perth-intro">{perthAnalyticsData.deliverables.intro}</p>
      <ul class="perth-grid perth-grid--3 perth-checks">
        {perthAnalyticsData.deliverables.items.map(item => (
          <li class="perth-tile">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span><strong>{item.name}</strong> - {item.description}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="perth-section">
      <h2 id="local-context"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.rocket} />{perthAnalyticsData.localContext.title}</h2>
      <p class="perth-intro">{perthAnalyticsData.localContext.paragraph}</p>
      <div class="perth-grid perth-grid--2">
        {perthAnalyticsData.localContext.points.map(point => (
          <div class="perth-tile">
            <h3>{point.label}</h3>
            <p>{point.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="perth-section">
      <h2 id="objections"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.users} />{perthAnalyticsData.objections.title}</h2>
      <p class="perth-intro">{perthAnalyticsData.objections.intro}</p>
      <div class="perth-grid perth-grid--3">
        {perthAnalyticsData.objections.items.map(item => (
          <div class="perth-tile">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="perth-section">
      <h2 id="business-practice"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.wrench} />{perthAnalyticsData.credentials.title}</h2>
      <p class="perth-intro">{perthAnalyticsData.credentials.intro}</p>
      <div class="perth-credentials">
        {perthAnalyticsData.credentials.items.map(item => (
          <div class="perth-credential">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span><strong>{item.name}</strong> {item.detail}</span>
          </div>
        ))}
      </div>
      <p class="perth-note">{perthAnalyticsData.credentials.footnote}</p>
    </section>

    <section class="perth-section">
      <h2 id="engagement"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.gitBranch} />{perthAnalyticsData.engagement.title}</h2>
      <p class="perth-intro">{perthAnalyticsData.engagement.intro}</p>
      <div class="perth-grid perth-grid--2">
        {perthAnalyticsData.engagement.models.map((model, i) => (
          <div class={`perth-tile${i === 0 ? ' perth-tile--lead' : ''}`}>
            {i === 0 && <span class="tile-kind">Start here</span>}
            <h3>{model.name}</h3>
            <p>{model.description}</p>
            <p class="tile-detail">{model.details}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="perth-section">
      <h2 id="faq"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.sparkles} />{perthAnalyticsData.faq.title}</h2>
      {perthAnalyticsData.faq.items.map(item => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <section class="perth-section">
      <h2 id="related"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.layers} />Related</h2>
      <ul class="perth-related">
        <li><a href="/consultancy">Consultancy</a> - the full range of engagements, including AI automation and team upskilling, with a case study.</li>
        <li><a href="/expertise">Expertise</a> - the platforms and skills behind this practice.</li>
        <li><a href="/builds">Builds</a> - the products and open source work.</li>
        <li><a href="/work-experience">Work Experience</a> - agency and enterprise background across Perth media and marketing.</li>
      </ul>
    </section>

    <section class="perth-section perth-cta">
      <h2 id="contact"><span class="section-icon" aria-hidden="true" set:html={sectionIcons.users} />{perthAnalyticsData.cta.title}</h2>
      <p>{perthAnalyticsData.cta.paragraph}</p>
      <div class="cta-buttons">
        <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="cta-primary" data-glow>Book a Discovery Call</a>
        <a href="/contact" class="cta-secondary" data-glow>Send a Message</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
.perth-section {
  margin-bottom: 3.5rem;
}

.perth-hero {
  margin-bottom: 3.5rem;
}

.perth-hero h1 {
  margin-bottom: 1rem;
  color: var(--color-text-heading);
}

.perth-section h2 {
  font-size: 1.8rem;
  margin-bottom: 0.5rem;
  color: var(--color-text-heading);
}

/* One short line under each heading, quieter than body copy. */
.perth-intro {
  color: var(--color-text-tertiary);
  max-width: 60ch;
  margin-bottom: 0;
}

.perth-note {
  font-size: 0.9rem;
  color: var(--color-text-tertiary);
}

/* Hero: the complaints people arrive with, as chips. */
.perth-signals {
  list-style: none;
  padding: 0;
  margin: 1.5rem 0 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.perth-signals li {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.4rem 0.8rem;
  border: 1px solid var(--color-border-primary);
  border-radius: 999px;
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
  font-size: 0.85rem;
  line-height: 1.3;
}

.perth-signals svg {
  color: var(--color-accent);
  flex-shrink: 0;
}

/* Tiles: the shared card for every grid on the page. */
.perth-grid {
  display: grid;
  gap: 0.85rem;
  margin: 1.5rem 0 0;
  padding: 0;
  list-style: none;
}

.perth-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.perth-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

.perth-tile {
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border-primary);
  border-radius: 10px;
  padding: 1.15rem 1.25rem;
  min-width: 0;
}

.perth-tile h3 {
  font-size: 1rem;
  line-height: 1.35;
  color: var(--color-text-heading);
  margin: 0 0 0.4rem;
}

.perth-tile p {
  font-size: 0.87rem;
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin: 0;
}

.perth-tile .tile-detail {
  margin-top: 0.5rem;
  color: var(--color-text-tertiary);
}

.tile-kind {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 0.5rem;
}

.perth-tile--lead {
  grid-column: 1 / -1;
  background: var(--color-accent-subtle);
  border-color: var(--color-accent);
}

.perth-checks .perth-tile {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  font-size: 0.87rem;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.perth-checks svg {
  color: var(--color-accent);
}

.perth-checks strong {
  color: var(--color-text-heading);
}

.perth-callout {
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border-primary);
  border-radius: 10px;
  padding: 1.15rem 1.25rem;
  margin-top: 0.85rem;
  color: var(--color-text-primary);
  font-size: 0.92rem;
  line-height: 1.6;
}

/* Folding rows: services and symptoms open one at a time on demand. */
.perth-accordion {
  margin-top: 1.5rem;
  border: 1px solid var(--color-border-primary);
  border-radius: 10px;
  overflow: hidden;
}

.perth-fold + .perth-fold {
  border-top: 1px solid var(--color-border-primary);
}

.perth-fold > summary {
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: flex-start;
  gap: 0.9rem;
  padding: 1rem 1.25rem;
  background: var(--color-bg-secondary);
}

.perth-fold > summary::-webkit-details-marker {
  display: none;
}

.perth-fold > summary::after {
  content: '';
  width: 8px;
  height: 8px;
  margin: 0.4rem 0.2rem 0 auto;
  border-right: 2px solid var(--color-accent);
  border-bottom: 2px solid var(--color-accent);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.perth-fold[open] > summary::after {
  transform: rotate(-135deg);
  margin-top: 0.65rem;
}

.perth-fold > summary:hover h3 {
  color: var(--color-accent);
}

.fold-index {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: var(--color-accent);
  color: var(--color-accent-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.78rem;
  font-weight: 600;
  flex-shrink: 0;
}

.fold-heading {
  min-width: 0;
}

.fold-heading h3 {
  font-size: 1.02rem;
  line-height: 1.4;
  color: var(--color-text-heading);
  margin: 0;
}

.fold-sub {
  display: block;
  margin-top: 0.25rem;
  font-size: 0.87rem;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.fold-list {
  list-style: none;
  margin: 0;
  padding: 1rem 1.25rem 1.15rem;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.55rem 1.5rem;
}

.fold-list li {
  position: relative;
  padding-left: 1.1rem;
  font-size: 0.87rem;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.fold-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.55em;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--color-accent);
}

.fold-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.5rem;
  padding: 1rem 1.25rem 1.15rem;
}

.fold-pair p {
  margin: 0;
  font-size: 0.87rem;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.pair-label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-text-tertiary);
  margin-bottom: 0.3rem;
}

.pair-label--fix {
