---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Henrik Söderlund"
  description="The page you are looking for does not exist."
>
  <div class="container">
    <div class="not-found-container">
      <div class="ascii-art">
        <pre>{`┌─────────────────────────────────┐
│                                 │
│     ██  ██   ████   ██  ██      │
│     ██  ██  ██  ██  ██  ██      │
│     ██████  ██  ██  ██████      │
│         ██  ██  ██      ██      │
│         ██   ████       ██      │
│                                 │
│         Page Not Found          │
│                                 │
└─────────────────────────────────┘`}</pre>
      </div>

      <div class="error-message">
        <h1>Oops! Page not found</h1>
        <p>The page you're looking for doesn't exist.</p>
        <nav aria-label="Suggested pages" class="not-found-nav">
          <p><a href="/">Return to homepage</a></p>
          <ul>
            <li><a href="/expertise">Expertise</a></li>
            <li><a href="/consultancy">Consultancy</a></li>
            <li><a href="/work-experience">Work Experience</a></li>
            <li><a href="/contact">Get in Touch</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
/* The global reset zeroes list padding, so a plain <ul> renders its discs
   outside the content box - and the centred container then pushes the text
   away from them. Lay the suggestions out as a centred row instead, matching
   the link groups used elsewhere on the site. */
.not-found-nav {
  width: 100%;
  margin-top: 0.5rem;
}

.not-found-nav ul {
  list-style: none;
  padding: 0;
  margin: 1rem 0 0 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.6rem 1.5rem;
}

.not-found-nav li {
  margin: 0;
}

.not-found-nav a {
  display: inline-block;
  padding: 0.35rem 0;
  color: var(--color-text-secondary);
  font-size: 0.95rem;
}

.not-found-nav a:hover {
  color: var(--color-link-hover);
}

@media (max-width: 480px) {
  .not-found-nav ul {
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
}
</style>
