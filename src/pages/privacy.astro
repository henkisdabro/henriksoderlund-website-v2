---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRIVACY_EMAIL } from '../data/links';
import '../styles/content-entry.css';

// Harvester-resistant rendering. The address appears nowhere in the HTML, in
// any spelling: each half is reversed into its own data attribute, so neither
// attribute alone yields it and an email regex over the page finds no match.
// The inline script below reassembles it into a real mailto: link. Without
// scripting the address is never revealed at all - the contact form carries
// the request instead, so a data-subject request still has a route.
const [emailLocal, emailDomain] = PRIVACY_EMAIL.split('@');
const reverse = (value: string) => [...value].reverse().join('');
const emailLocalReversed = reverse(emailLocal);
const emailDomainReversed = reverse(emailDomain);
---

<BaseLayout
  title="Privacy Policy | Henrik Söderlund"
  description="Privacy policy for henriksoderlund.com - how personal information is collected, used, and protected."
>
  <div class="privacy-page">
    <h1>Privacy Policy</h1>

    <p class="dates">Last updated: 29 August 2026</p>

    <p>
      This privacy policy explains how personal information is collected, used, and protected when you visit
      henriksoderlund.com or use the contact form on this site. This site is operated by Henrik Söderlund,
      an independent technology consultant based in Perth, Australia.
    </p>

    <section class="content-entry">
      <h2 id="information-collected">Information Collected</h2>
      <p>
        This site collects personal information only when you voluntarily submit it through the contact form.
        The information collected includes your name, email address, and the content of your message.
      </p>
      <p>
        No account registration is required to browse this site. Analytics cookies are set in your browser
        when you visit. They are listed by name, purpose and lifetime under Third-Party Services below.
      </p>
    </section>

    <section class="content-entry">
      <h2 id="how-information-is-used">How Your Information Is Used</h2>
      <p>
        Contact form submissions are used solely to respond to your enquiry. Your name and email address are
        included in the email sent to me so that I can reply to you directly. Form data is not stored in any
        database and is not used for marketing purposes.
      </p>
    </section>

    <section class="content-entry">
      <h2 id="third-party-services">Third-Party Services</h2>
      <p>The following third-party services process data in connection with this site:</p>
      <ul>
        <li>
          <strong>Cloudflare</strong> provides hosting, content delivery, and security services.
          Cloudflare processes standard web request data (IP addresses, browser information) as part of
          delivering pages and protecting against abuse. Cloudflare also serves a page-performance beacon
          that reports load timings and sets no cookies.
        </li>
        <li>
          <strong>Cloudflare Turnstile</strong> is used on the contact form to verify that submissions
          come from real visitors rather than automated bots. Turnstile sends your IP address and browser
          signals to Cloudflare for verification when the form is submitted. It sets no cookies on this site.
        </li>
        <li>
          <strong>Resend</strong> delivers the email generated by the contact form. Your name, email address,
          and message content are transmitted through Resend's email delivery infrastructure.
        </li>
        <li>
          <strong>Google Analytics 4</strong>, operated by Google, measures how this site is used. It is
          loaded through a server-side Google Tag Manager container on a first-party subdomain, and
          measurement requests are sent to a first-party path on this domain rather than straight to
          Google's own collection endpoints. Server-side tagging changes where the request goes and where
          the identifier is written; it does not remove the identifier. Google acts as a processor for this
          measurement data. The following cookies are set on henriksoderlund.com:
          <ul>
            <li>
              <code>_ga</code> and <code>_ga_&lt;measurement-id&gt;</code> - the Google Analytics visitor
              and session identifiers, written by JavaScript in your browser. Both last 400 days from your
              most recent visit.
            </li>
            <li>
              <code>FPID</code> - a first-party identifier written by the server-side container. It is
              marked HttpOnly, so JavaScript on the page cannot read it. It lasts 400 days.
            </li>
            <li>
              <code>FPLC</code> - a short-lived value that carries the identifier across a link to another
              domain. It lasts 20 hours.
            </li>
          </ul>
          These identifiers are randomly generated. They are not derived from your name, email address or
          anything else you type, and nothing you submit through the contact form is sent to Google
          Analytics. They are pseudonymous rather than anonymous: they persist between visits, which is
          what lets Google Analytics recognise a returning browser.
        </li>
        <li>
          <strong>Google advertising.</strong> Google Signals and ads personalisation are switched off on
          the analytics property, so the tag sends nothing to Google's advertising domains. Your visit is
          not added to a Google advertising audience, and the measurement data above is not used to
          personalise advertising. Nothing you submit through the contact form is sent to Google at all.
        </li>
        <li>
          <strong>Fou Analytics</strong> provides traffic-quality and bot-detection analytics. It sets no
          cookies and writes nothing to your browser's storage. It does receive your IP address and browser
          characteristics, which count as personal information under GDPR and Australian privacy law, and
          uses them to distinguish automated traffic from human visitors.
        </li>
        <li>
          <strong>Calendly</strong> handles bookings for discovery calls. This site links out to Calendly
          rather than embedding it, so nothing you enter there passes through this site. The name, email
          address and answers you give when booking go to Calendly and are then passed on to me.
          Calendly's own privacy policy governs what happens on their site.
        </li>
      </ul>
    </section>

    <section class="content-entry">
      <h2 id="external-links">External Links</h2>
      <p>
        This site contains links to external services including Calendly, LinkedIn, and GitHub. These are
        third-party websites with their own privacy policies. Clicking these links takes you outside of
        henriksoderlund.com, and this privacy policy does not apply to those sites.
      </p>
    </section>

    <section class="content-entry">
      <h2 id="data-retention">Data Retention</h2>
      <p>
        Contact form submissions are delivered as email and are not stored in any server-side database.
        Email correspondence is retained for the duration necessary to respond to your enquiry and manage
        any subsequent engagement.
      </p>
      <p>
        Analytics data collected through Google Analytics and Fou Analytics is pseudonymous: it is keyed to
        the randomly generated identifiers described above, not to your name or email address. It is not
        anonymous, and it is not aggregated at the point of collection - Google Analytics records
        individual events against a per-browser identifier. No profile linking that identifier to a named
        person is created or retained by me. The cookies themselves expire on the schedules listed above.
      </p>
    </section>

    <section class="content-entry">
      <h2 id="your-rights">Your Rights</h2>
      <p>
        You may request access to, correction of, or deletion of any personal information held about you.
        To make a request, please <span class="protected-email" data-l={emailLocalReversed}
        data-d={emailDomainReversed}>use the <a href="/contact">contact form</a></span>. You can also clear
        the analytics cookies listed above at any time through your browser's settings, which resets the
        identifiers they hold.
      </p>
      <p>
        This site is operated from Australia. If you are visiting from the European Union or United Kingdom,
        your data is processed in accordance with the same standards described in this policy. You have the
        right to lodge a complaint with your local data protection authority if you believe your personal
        information has been handled improperly.
      </p>
    </section>

    <section class="content-entry">
      <h2 id="changes">Changes to This Policy</h2>
      <p>
        This privacy policy may be updated from time to time. Any changes will be reflected on this page
        with an updated date. Continued use of the site after changes constitutes acceptance of the
        revised policy.
      </p>
    </section>

    <section class="content-entry">
      <h2 id="contact">Contact</h2>
      <p>
        If you have questions about this privacy policy or how your personal information is handled,
        please <span class="protected-email" data-l={emailLocalReversed}
        data-d={emailDomainReversed}>use the <a href="/contact">contact form</a></span>.
      </p>
    </section>
  </div>

  <script is:inline data-csp>
    // Swaps each .protected-email span's contact-form fallback for a real
    // mailto: link. Delegated click tracking in BaseLayout listens on document,
    // so the `email_click` event still fires for a link created here.
    (function () {
      const nodes = document.querySelectorAll('.protected-email');
      for (const node of nodes) {
        const local = node.getAttribute('data-l');
        const domain = node.getAttribute('data-d');
        if (!local || !domain) continue;
        const address = [...local].reverse().join('') + String.fromCharCode(64) + [...domain].reverse().join('');
        const link = document.createElement('a');
        link.href = 'mailto:' + address;
        link.textContent = address;
        // Clears the fallback anchor before appending the real one.
        node.textContent = 'email ';
        node.appendChild(link);
      }
    })();
  </script>
</BaseLayout>
