---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import profileImage from '../assets/images/henrik-profile-small.webp';
import { sectionIcons } from '../utils/sectionIcons';
import { CALENDLY_URL, ASCRIBE_URL, ROTTOSNORKEL_URL, productLink } from '../data/links';
// Bundled from src/scripts/depth-grain.js by scripts/build-depth-grain.mjs.
import depthGrain from '../generated/depth-grain.js?raw';
---

<BaseLayout
  mentions={['ascribe', 'googleAnalytics', 'aiAssistedDevelopment']}
  title="Henrik Söderlund | Independent Technology Consultant, Perth"
  description="Independent technology consultant in Perth. I work out what is slowing a business down, then build the fix - usually some mix of automation, data and software."
  ogType="profile"
>
  <div class="gg-field" id="gg-field" slot="backdrop" aria-hidden="true"><div class="gg-haze"></div><canvas class="gg-far"></canvas><canvas class="gg-near"></canvas></div>

  <!-- Hero entrance: once per session, never under reduced motion. Runs before
       the hero is parsed, so the first paint already starts the animation. -->
  <script is:inline data-csp>
    (function () {
      let seen = null;
      try { seen = sessionStorage.getItem('hero-entered'); sessionStorage.setItem('hero-entered', '1'); } catch { /* storage unavailable */ }
      if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const d = document.documentElement;
      d.classList.add('hero-enter');
      setTimeout(function () { d.classList.remove('hero-enter'); }, 1500);
    })();
  </script>

  <div class="home-page">
    <div class="hero-section">
      <div class="portrait">
        <span class="aurora" aria-hidden="true"></span>
        <span class="portrait-ring" aria-hidden="true"></span>
        <img
        src={profileImage.src}
        alt="Henrik Söderlund, independent technology consultant based in Perth, Australia"
        class="profile-image"
        width="150"
        height="150"
        fetchpriority="high"
        decoding="async"
      />
      </div>
      <h1>Henrik Söderlund</h1>
      <p class="lead" style="--i: 1">
        Independent consultant in Perth. I work out what is slowing a business down, then build the fix - usually some mix of automation, data and software.
      </p>
      <section class="home-cta cta-buttons" style="--i: 2">
        <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="cta-primary" data-glow>Book a Discovery Call</a>
        <a href="/contact" class="cta-secondary" data-glow>Send a Message</a>
      </section>
    </div>

    <section class="content-section">
      <h2 id="what-clients-bring-me">What clients bring me <span class="section-icon" aria-hidden="true" set:html={sectionIcons.sparkles} /></h2>
      <p>
        Usually some version of the same thing: numbers nobody trusts, reporting someone rebuilds by hand every month, or work that still runs on email and spreadsheets. I have fixed it for WA government, agencies, ad tech, entertainment and not-for-profit health. For one 150-person agency, automating project and billing workflows cut admin time by 75 per cent and recovered AUD 285,000 in unbilled work. I do the implementation myself.
      </p>
    </section>

    <section class="content-section">
      <h2 id="how-i-build">How I build <span class="section-icon" aria-hidden="true" set:html={sectionIcons.wrench} /></h2>
      <p>
        I build with AI coding agents, and I review and test everything they write. One workflow I built turns a signed proposal into a live project in seven minutes, down from 45-60. My own practice runs the same way, on agents I built to handle proposals and invoicing.
      </p>
    </section>

    <section class="content-section prose">
      <h2 id="things-ive-built">Things I've built <span class="section-icon" aria-hidden="true" set:html={sectionIcons.layers} /></h2>
      <p>
        <a href={productLink(ASCRIBE_URL, 'home-built-link')} target="_blank" rel="noopener noreferrer">ascribe</a> checks marketing tracking links against an organisation's own GA4 channel definitions before launch. <a href={productLink(ROTTOSNORKEL_URL, 'home-built-link')} target="_blank" rel="noopener noreferrer">Rotto Snorkel</a> turns live wind, wave and swell data into safety ratings for 36 snorkel spots around Rottnest.
      </p>
    </section>

    <section class="content-section prose">
      <h2 id="background">Background <span class="section-icon" aria-hidden="true" set:html={sectionIcons.users} /></h2>
      <p>
        Before going independent I spent more than ten years on the media side: I co-founded the award-winning{" "}
        <a
          href="https://www.cremedigital.com?utm_source=www.henriksoderlund.com&utm_medium=referral"
          target="_blank"
          rel="noopener noreferrer"
        >
          Creme Digital
        </a>{" "}
        in Kuala Lumpur, then led activation teams at Initiative Perth. Before that, I played trombone for a living.
      </p>

      <div class="expertise-link-section">
        <a href="/consultancy" class="expertise-link" data-glow><span class="label">How I work with clients</span> <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/builds" class="expertise-link" data-glow><span class="label">See what I build</span> <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/perth-analytics-consultant" class="expertise-link" data-glow><span class="label">GA4 &amp; analytics in Perth</span> <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/work-experience" class="expertise-link" data-glow><span class="label">Full background</span> <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<!-- Depth over grain: a faint mesh gradient in the accent family (Paper
     Shaders, WebGL2) with film grain, under drifting hairlines that take their
     tint from it. Source in src/scripts/depth-grain.js; inlined so the Worker's
     nonce covers it. -->
<script is:inline data-csp set:html={depthGrain}></script>

<style is:global>
/* Home Page Styles */
.hero-section {
  text-align: center;
  margin-bottom: 3rem;
}

.portrait {
  position: relative;
  width: 150px;
  height: 150px;
  margin: 0 auto 1rem;
  isolation: isolate;
}

.profile-image {
  position: relative;
  z-index: 2;
  display: block;
  width: 150px;
  height: 150px;
  border-radius: 50%;
  object-fit: cover;
}

/* Glow behind the portrait: two blurred layers of accent-family blobs turn at
   different speeds in opposite directions. Transform-only, so the blur is
   rasterised once and the compositor does the rest. */
.aurora {
  position: absolute;
  inset: -48px;
  z-index: 0;
  pointer-events: none;
}

.aurora::before,
.aurora::after {
  content: "";
  position: absolute;
  inset: 0;
  filter: blur(var(--aurora-blur));
  will-change: transform;
}

.aurora::before {
  background:
    radial-gradient(closest-side at 26% 40%, var(--aurora-1), transparent),
    radial-gradient(closest-side at 74% 34%, var(--aurora-2), transparent);
  animation: aurora-turn 34s linear infinite;
}

.aurora::after {
  inset: 14px;
  background:
    radial-gradient(closest-side at 62% 70%, var(--aurora-3), transparent),
    radial-gradient(closest-side at 30% 64%, var(--aurora-2), transparent);
  animation: aurora-turn 47s linear infinite reverse;
}

/* Dark only (--aurora-ring is 0 in light): a hairline ring with a travelling
   highlight, so dark reads as emitted light rather than inverted ink. */
.portrait-ring {
  position: absolute;
  inset: -7px;
  z-index: 1;
  border-radius: 50%;
  pointer-events: none;
  opacity: var(--aurora-ring);
  background: conic-gradient(from 0deg, transparent 0 52%, rgba(129, 140, 248, 0) 52%, rgba(129, 140, 248, 0.7) 74%, #38bdf8 90%, rgba(186, 230, 253, 1) 96%, transparent 100%);
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
  mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
  animation: aurora-turn 9s linear infinite;
}

.portrait-ring::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1px rgba(56, 189, 248, 0.14);
}

.portrait.is-paused .aurora::before,
.portrait.is-paused .aurora::after,
.portrait.is-paused .portrait-ring { animation-play-state: paused; }

@keyframes aurora-turn {
  to { transform: rotate(1turn); }
}

/* Entrance, once per session. The portrait never starts transparent - it is
   the LCP element - and neither does the h1; the lead and CTAs follow. */
.hero-enter .profile-image { animation: hero-settle 700ms var(--ease-out) both; }

.hero-enter .aurora,
.hero-enter .portrait-ring { animation: hero-bloom 1400ms var(--ease-out) both; }

.hero-enter .hero-section > .lead,
.hero-enter .hero-section > .home-cta {
  animation: hero-rise 560ms var(--ease-out) both;
  animation-delay: calc(var(--i, 1) * var(--stagger));
}

@keyframes hero-settle { from { transform: scale(0.97); } }
@keyframes hero-bloom { from { opacity: 0; transform: scale(0.82); } }
@keyframes hero-rise { from { opacity: 0; transform: translateY(10px); } }

/* Depth field behind the hero. It sits outside .app, so .app is lifted above
   it - only on this page, where the field exists. */
.gg-field ~ .app {
  position: relative;
  z-index: 1;
}

.gg-field {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 760px;
  overflow: hidden;
  contain: paint;
  pointer-events: none;
  opacity: 0;
  transition: opacity 1.8s var(--ease-out);
  /* fades to nothing at the sides, under the top bar and before the first section */
  -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent), linear-gradient(transparent, #000 14%, #000 70%, transparent);
  -webkit-mask-composite: source-in;
  mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent), linear-gradient(transparent, #000 14%, #000 70%, transparent);
  mask-composite: intersect;
}

.gg-field.is-on { opacity: 1; }

.gg-field > canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.gg-field .gg-far { filter: blur(var(--field-blur)); }

/* The haze overscans the field by 40px so the pointer can shift it without
   showing an edge, and fades out from just below the portrait. */
.gg-haze {
  position: absolute;
  inset: -40px;
  opacity: var(--haze-k);
  transition: opacity 0.6s var(--ease-out);
  --gx: 50%;
  --gy: 25%;
  -webkit-mask-image: radial-gradient(ellipse min(620px, 62%) min(440px, 72%) at var(--gx) var(--gy), #000, rgba(0, 0, 0, 0.55) 45%, transparent);
  mask-image: radial-gradient(ellipse min(620px, 62%) min(440px, 72%) at var(--gx) var(--gy), #000, rgba(0, 0, 0, 0.55) 45%, transparent);
}

.gg-haze canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* No WebGL2, or the context was lost: a still CSS haze in the same colours. */
.gg-field.no-gl .gg-haze {
  background:
    radial-gradient(closest-side at calc(var(--gx) - 140px) calc(var(--gy) + 30px), rgba(var(--haze-1)), transparent),
    radial-gradient(closest-side at calc(var(--gx) + 160px) calc(var(--gy) - 10px), rgba(var(--haze-2)), transparent),
    radial-gradient(closest-side at var(--gx) calc(var(--gy) + 120px), rgba(var(--haze-3)), transparent);
  background-size: 100% 100%;
}

.hero-section h1 {
  margin-bottom: 1rem;
  color: var(--color-text-heading);
}

.lead {
  font-size: 1.2rem;
  line-height: 1.4;
  max-width: 600px;
  margin: 0 auto 2rem auto;
  color: var(--color-text-secondary);
  font-weight: 400;
}

.home-cta {
  justify-content: center;
  margin-top: 0;
}

.content-section {
  margin-bottom: 3rem;
}

.content-section h2 {
  font-size: 1.8rem;
  margin-bottom: 1rem;
  color: var(--color-text-heading);
  text-align: center;
}

.content-section p {
  margin-bottom: 1rem;
  text-align: left;
}

.expertise-link-section {
  margin-top: 2rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.75rem;
  justify-content: center;
}

.expertise-link {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  color: var(--color-text-heading);
  font-size: 1rem;
  font-weight: 400;
  padding: 0.6rem 1.2rem;
  border-radius: 6px;
  line-height: 1;
  gap: 0.35em;
}

.expertise-link:hover {
  color: var(--color-text-heading);
  text-decoration: none;
}

.expertise-link .label {
  background: linear-gradient(currentColor, currentColor) left 100% / 0% 1px no-repeat;
  padding-bottom: 2px;
  transition: background-size var(--dur-base) var(--ease-out);
}

.expertise-link:hover .label,
.expertise-link:focus-visible .label {
  background-size: 100% 1px;
}

.expertise-link .arrow {
  display: inline-block;
  transition: transform var(--dur-base) var(--ease-out);
}

.expertise-link:hover .arrow,
.expertise-link:focus-visible .arrow {
  transform: translateX(3px);
}

@media (max-width: 768px) {
  .lead {
    font-size: 1rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .aurora::before,
  .aurora::after,
  .portrait-ring { animation: none; }
  .portrait-ring { transform: rotate(200deg); }
  .gg-field,
  .gg-haze,
  .expertise-link .label,
  .expertise-link .arrow { transition: none; }
}
</style>
